[
  { "id": "001", "text": "我家有四口人。", "title": "My Family" },
  { "id": "002", "text": "我叫李明。", "title": "My Family" },
  { "id": "003", "text": "我是学生。", "title": "My Family" },
  { "id": "004", "text": "我今年十岁。", "title": "My Family" },
  { "id": "005", "text": "我家在北京。", "title": "My Family" },
  { "id": "006", "text": "爸爸是老师。", "title": "My Family" },
  { "id": "007", "text": "妈妈是老师。", "title": "My Family" },
  { "id": "008", "text": "朋友是学生。", "title": "My Family" },
  { "id": "009", "text": "她喜欢汉语。", "title": "My Family" },
  { "id": "010", "text": "我喜欢汉语。", "title": "My Family" },
  { "id": "011", "text": "今天星期一。", "title": "My Family" },
  { "id": "012", "text": "上午，我和朋友去学校。", "title": "My Family" },
  { "id": "013", "text": "老师说：你好！", "title": "My Family" },
  { "id": "014", "text": "我说：老师好！", "title": "My Family" },
  { "id": "015", "text": "中午，我们喝水，吃米饭。", "title": "My Family" },
  { "id": "016", "text": "我们看书。", "title": "My Family" },
  { "id": "017", "text": "我们回家。", "title": "My Family" },
  { "id": "018", "text": "爸爸妈妈都在家。", "title": "My Family" },
  { "id": "019", "text": "我今天很高兴。", "title": "My Family" }
]
