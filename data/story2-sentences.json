[
  { "id": "001", "text": "今天是星期一，上午我去学校。", "title": "A School Day" },
  { "id": "002", "text": "我是学生。", "title": "A School Day" },
  { "id": "003", "text": "上午，学校里有老师，也有同学。", "title": "A School Day" },
  { "id": "004", "text": "我和同学在学校看书。", "title": "A School Day" },
  { "id": "005", "text": "朋友看见我。", "title": "A School Day" },
  { "id": "006", "text": "星期一，我和朋友说你好。", "title": "A School Day" },
  { "id": "007", "text": "朋友给我书。", "title": "A School Day" },
  { "id": "008", "text": "我说谢谢。", "title": "A School Day" },
  { "id": "009", "text": "朋友说不客气。", "title": "A School Day" },
  { "id": "010", "text": "下午我给妈妈打电话。", "title": "A School Day" },
  { "id": "011", "text": "妈妈看见我，很高兴。", "title": "A School Day" },
  { "id": "012", "text": "晚上我看电视。", "title": "A School Day" },
  { "id": "013", "text": "我看电影。", "title": "A School Day" },
  { "id": "014", "text": "我还去学校。", "title": "A School Day" },
  { "id": "015", "text": "我们都很高兴。", "title": "A School Day" },
  { "id": "016", "text": "我们回家。", "title": "A School Day" }
